# Copy to .env and replace the master key before accepting any document.
KOSHSHIELD_ENVIRONMENT=development
KOSHSHIELD_DATABASE_URL=postgresql+psycopg://koshshield:koshshield@localhost:5432/koshshield
KOSHSHIELD_QDRANT_URL=http://localhost:6333
KOSHSHIELD_LLAMA_BASE_URL=http://localhost:8080/v1
KOSHSHIELD_VAULT_DIR=./data/vault
KOSHSHIELD_MASTER_KEY_BASE64=
KOSHSHIELD_AUTO_CREATE_SCHEMA=true
KOSHSHIELD_MAX_UPLOAD_BYTES=26214400
KOSHSHIELD_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local PaddleOCR model directories (optional, air-gapped)
# KOSHSHIELD_OCR_DET_MODEL_DIR=./models/ocr/det
# KOSHSHIELD_OCR_REC_MODEL_DIR=./models/ocr/rec
# KOSHSHIELD_OCR_CLS_MODEL_DIR=./models/ocr/cls
# Salt used for hashing detected PII values (never store raw PII in DB)
KOSHSHIELD_PII_SALT=koshshield-default-dev-salt

# Local BGE-M3 Embedding Model (optional, strictly local-files-only)
# KOSHSHIELD_EMBEDDING_MODEL_DIR=./models/bge-m3
KOSHSHIELD_EMBEDDING_DEVICE=cpu
KOSHSHIELD_EMBEDDING_BATCH_SIZE=16
KOSHSHIELD_QDRANT_COLLECTION=koshshield_masked_docs
KOSHSHIELD_RETRIEVAL_RRF_K=60
KOSHSHIELD_MAX_SEARCH_TOP_K=50

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
